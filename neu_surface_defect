SIZE,\n    class_mode='categorical',\n    shuffle=False\n)\n\nclass_names = list(train_data.class_indices.keys())\nnum_classes = train_data.num_classes\nprint(f'Class mapping: {train_data.class_indices}')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-30T21:55:23.212624Z","iopub.execute_input":"2026-09-30T21:55:23.213542Z","iopub.status.idle":"2026-09-30T21:55:23.613799Z","shell.execute_reply.started":"2026-09-30T21:55:23.213503Z","shell.execute_reply":"2026-09-30T21:55:23.61295Z"}},"outputs":[{"name":"stdout","text":"Found 1440 images belonging to 6 classes.\nFound 360 images belonging to 6 classes.\nClass mapping: {'crazing': 0, 'inclusion': 1, 'patches': 2, 'pitted_surface': 3, 'rolled-in_scale': 4, 'scratches': 5}\n","output_type":"stream"}],"execution_count":12},{"id":"a8747f69-497f-4164-a8e9-22a03984140b","cell_type":"markdown","source":"## 4. Visualize Sample Images\n\nA small labeled batch provides a quick visual sanity check before training.","metadata":{}},{"id":"2a5b628b-db68-4d4d-971b-3a85d5f702ad","cell_type":"code","source":"images, labels = next(train_data)\nsample_count = min(9, len(images))\nlabel_lookup = {index: name for name, index in train_data.class_indices.items()}\n\nfig, axes = plt.subplots(3, 3, figsize=(10, 10))\nfor index, ax in enumerate(axes.flat):\n    if index < sample_count:\n        image = (images[index] + 1.0) / 2.0\n        ax.imshow(np.clip(image, 0, 1))\n        ax.set_title(label_lookup[np.argmax(labels[index])])\n    ax.axis('off')\n\nplt.tight_layout()\nplt.show()\ntrain_data.reset()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-30T21:55:32.342338Z","iopub.execute_input":"2026-09-30T21:55:32.34271Z","iopub.status.idle":"2026-09-30T21:55:33.775454Z","shell.execute_reply.started":"2026-09-30T21:55:32.342678Z","shell.execute_reply":"2026-09-30T21:55:33.774258Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x1000 with 9 Axes>","image/png":"\n"